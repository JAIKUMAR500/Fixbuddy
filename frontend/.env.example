# Leave empty in local web dev (Vite proxies /api to the backend).
# On Vercel, either form works:
#   https://fixbuddy-1-nh5a.onrender.com
#   https://fixbuddy-1-nh5a.onrender.com/api
#
# Android WebView cannot use relative /api. Leave empty to use the live Render API,
# or set one of these before `npm run android:sync`:
#   VITE_API_URL=https://fixbuddy-1-nh5a.onrender.com
#   VITE_API_URL=http://10.0.2.2:4000
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Do not put JWT secrets, SMTP passwords, or Mongo URIs in frontend env.

