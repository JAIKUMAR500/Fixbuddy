PORT=4000
MONGODB_URI=mongodb://localhost:27017/fixbuddy
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES=7d
# Short-lived access JWT. Refresh cookie/token lasts JWT_REFRESH_EXPIRES (or JWT_EXPIRES).
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173,https://fixbuddy-ivory.vercel.app,https://localhost,capacitor://localhost
API_PUBLIC_URL=http://localhost:4000
# On Render set API_PUBLIC_URL=https://fixbuddy-1-nh5a.onrender.com
SUPPORT_EMAIL=jaikuma500500@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
# ── Payments ──────────────────────────────────────────────────────────────────
# development = simulated ledger only, no gateway calls, no real money.
# production  = live gateway. Requires PAYMENT_GATEWAY plus every secret below;
#               startup fails if any of them is missing, and the app falls back
#               to simulation rather than half-enabling real payments.
FINANCIAL_MODE=development
# razorpay | stripe  (leave empty for simulation)
PAYMENT_GATEWAY=
PAYMENT_CURRENCY=INR
# Razorpay: webhook URL is POST /api/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe alternative
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Same Web client ID as Super Admin → Settings. Google Cloud Authorized JavaScript origins:
# https://fixbuddy-ivory.vercel.app
# http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Object storage (S3, Cloudflare R2, Backblaze B2) ──────────────────────────
# Leave empty in local development: uploads fall back to backend/uploads/.
# Production refuses to start without these because container disks are ephemeral.
# Bucket + both keys are the minimum. S3_ENDPOINT is required for R2/B2.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN or custom domain in front of the bucket.
S3_PUBLIC_DOMAIN=

# ── Shared rate-limit store ───────────────────────────────────────────────────
# Set when running more than one API instance. Empty uses the in-process store.
# redis://localhost:6379
# rediss://:PASSWORD@host:6379  (TLS — never commit a real URL or password)
REDIS_URL=

